# Versión mitigada: Node.js 18 sobre Alpine, construcción multi-etapa y
# endurecimiento del runtime (sin npm/yarn dentro de la imagen final).
FROM node:18-alpine AS build

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:18-alpine

# Actualiza los paquetes del sistema operativo base y elimina herramientas
# que no son necesarias para ejecutar la API.
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm \
              /usr/local/lib/node_modules/corepack \
              /opt/yarn-* \
              /usr/local/bin/npm \
              /usr/local/bin/npx \
              /usr/local/bin/corepack \
              /usr/local/bin/yarn \
              /usr/local/bin/yarnpkg

WORKDIR /usr/src/app

COPY --from=build /usr/src/app/node_modules ./node_modules
COPY . .

EXPOSE 3000
USER node
CMD ["node", "server.js"]
