{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlySecureBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::actividad3-seguro-2024"
    },
    {
      "Sid": "ReadOnlyObjectsInSecureBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::actividad3-seguro-2024/*"
    }
  ]
}
